# SaaS Marketing Engine — deployment environment (S0.5, #80)
#
# Copy to /etc/sme/sme.env on the host, fill in the secrets, and `chmod 600` it. Both systemd
# units read it via EnvironmentFile, and deploy.sh sources it for the port check and the build.
# Never commit the filled-in copy — it holds the vault key and every API credential.

# --- ports (see PORTS.md; 8010/3010 are taken by other projects on this box) ---
SME_API_PORT=8020
SME_DASHBOARD_PORT=3020

# --- paths ---
# MUST be absolute in production. deploy_site resolves the emitted nginx `root` from this, and a
# relative value would be resolved by nginx against its own prefix (/etc/nginx) and 404 every
# published page — the failure class #78 exists to close, just relocated. TECH_SPEC §11.
SME_WORKSPACE_ROOT=/srv/sme/workspace
SME_NGINX_SITES_ROOT=/etc/nginx/sites-enabled
SME_NGINX_SNIPPETS_ROOT=/etc/nginx/snippets

# The one command the service user may run as root (see /etc/sudoers.d/sme-nginx). It tests the
# config before reloading, so a bad generated vhost can never take down the other projects on
# this box. Empty ⇒ deploy_site writes the vhost but does not reload (the dev/test default).
#
# Points at /usr/local/sbin, NOT at the checkout. provision.sh installs the script there as
# root:root 0755. If sudoers named a path inside /opt/sme/current — which the `sme` user owns and
# every deploy rewrites — then `sme` could edit the script it is allowed to run as root, and the
# sudoers rule would be a root shell rather than a narrow grant.
SME_NGINX_RELOAD_COMMAND="sudo /usr/local/sbin/sme-nginx-reload"

# --- origins ---
# CORS for the private dashboard API. The dashboard is loopback-only, so this is the SSH-tunnel
# origin the operator's browser actually uses. Verified by verify-deploy.sh before first deploy
# (NFR-2).
SME_CORS_ORIGINS=http://localhost:3020
SME_DASHBOARD_BASE_URL=http://localhost:3020
# Baked into every generated landing site's funnel JS, so it must be the PUBLIC origin nginx
# serves — not the loopback port. https once TLS is enabled for the domain.
SME_PUBLIC_API_BASE_URL=https://api.example.com
# OAuth callbacks land here; config.py rejects non-https off localhost, so this must be the real
# public origin before any channel is connected.
SME_OAUTH_REDIRECT_BASE_URL=https://api.example.com

# --- storage (Phase B: the box already runs both on localhost — reuse, do not double-bind) ---
SME_DATABASE_URL=sqlite:////srv/sme/sme.db
SME_CELERY_BROKER_URL=redis://localhost:6379/0

# --- secrets (fill in; never commit) ---
SME_VAULT_KEY=
SME_ANTHROPIC_API_KEY=
SME_STRIPE_API_KEY=
SME_STRIPE_WEBHOOK_SECRET=
SME_ELEVENLABS_API_KEY=
SME_GPU_API_KEY=
SME_GPU_POD_TEMPLATE_ID=

# --- operator alerts (S6.2 heartbeat digest) ---
SME_ALERT_EMAIL_TO=
SME_SMTP_HOST=
SME_SMTP_USER=
SME_SMTP_PASSWORD=
SME_SMTP_FROM=

# --- build toolchain ---
# The box's default node is 20; the dashboard (Next 16) is built and run against the node major
# that .nvmrc pins. deploy.sh puts this on PATH for the build and the dashboard unit uses it at
# runtime, so build and runtime cannot drift apart.
#
# NOT a path under /root/.nvm, even though that is where nvm installs it: /root is mode 700, so
# the unprivileged `sme` user cannot traverse into it no matter how the inner directories are
# permissioned, and the dashboard unit would die at exec time. provision.sh copies the toolchain
# to this root-owned, world-readable location instead.
SME_NODE_BIN=/usr/local/lib/sme-node/bin
